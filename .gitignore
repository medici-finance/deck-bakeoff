# rwa-bakeoff — keep deliverables (BRIEF, PROTOCOL, messaging/, tracks/*/<mode>/<m>/{deck,explainer}, NOTES,
# reviews/, bakeoff/, report.pdf, video/), drop build scaffolding and vendored bulk.

# build / generator scaffolding left by design agents
_build/
build/
_src/
.impeccable/
__pycache__/
*.pyc

# vendored runtimes fetched during the run (p5, mermaid) — re-fetchable
tracks/*/vendor/


# screenshot bulk (98 MB) — contact sheets + INDEX kept for the report
shots/**/slide-*.png
shots/**/scene-*.png
shots/_reviewer-frames/
shots/_probe.json
shots/*.png

# render pipeline output
out/
*.mp4
*.webm
*.wav

# interesting, but not relevant for the bakeoff
source/
social/

# OS / editor
.DS_Store
Thumbs.db

# --- house skills ARE tracked (everything else under skills/ stays ignored) ---
!skills/
skills/*
!skills/messaging/
skills/messaging/*
!skills/messaging/staging/
!skills/messaging/house-guide/
!skills/deck-author/
!skills/video-author/
!skills/video/
skills/video/*
!skills/video/video-design/
!skills/video/explainer-video/
skills/video/explainer-video/node_modules/
skills/video/explainer-video/out/
skills/video/explainer-video/__pycache__/
!skills/social/
skills/social/*
!skills/social/linkedin-post/
!skills/social/humanizer/
node_modules/
skills/video/explainer-video/voices/
